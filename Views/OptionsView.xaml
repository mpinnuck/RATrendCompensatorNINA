<ResourceDictionary
    x:Class="RATrendCompensatorNINA.Views.OptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Key MUST be "<IPluginManifest.Name>_Options". Name is populated from
        the [AssemblyTitle] in Properties/AssemblyInfo.cs, if you change
        that title, update this key to match.
    -->
    <DataTemplate x:Key="RA Trend Compensator Monitor_Options">
        <StackPanel Orientation="Vertical" MinWidth="260" Loaded="RootPanel_Loaded">
            <TextBlock Text="Status socket" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Text="Must match RA_TrendCompensator's status_server_host / status_server_port config."
                       TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Host" VerticalAlignment="Center" />
                <TextBox x:Name="HostBox" Grid.Column="1" LostFocus="HostBox_LostFocus" />
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Port" VerticalAlignment="Center" />
                <TextBox x:Name="PortBox" Grid.Column="1" LostFocus="PortBox_LostFocus" />
            </Grid>

            <CheckBox x:Name="EnabledBox" Content="Connect automatically" Checked="EnabledBox_Changed" Unchecked="EnabledBox_Changed" />

            <TextBlock Text="Restart NINA after changing these for the dockable panel to reconnect with the new values."
                       TextWrapping="Wrap" Opacity="0.6" FontStyle="Italic" Margin="0,10,0,0" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
